rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Un document par lieu, uniquement dans la collection "visited".
    // Accès public en lecture/écriture (pas de compte utilisateur), mais
    // on limite strictement la forme des documents pour éviter qu'un lien
    // partagé ne serve à écrire n'importe quoi dans la base.
    match /visited/{placeId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['visited', 'updatedAt'])
                   && request.resource.data.visited is bool;
    }

    // Un document par lieu dans la collection "reactions", de la forme
    // { votes: { <idAppareil>: <emoji> }, updatedAt: ... }. Meme compromis
    // que "visited" : ouvert en lecture/ecriture publique, mais on borne la
    // forme du document.
    match /reactions/{placeId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['votes', 'updatedAt'])
                   && request.resource.data.votes is map;
    }

    // Planning par jour : { day: 1..5 ou null, updatedAt: ... }.
    match /planning/{placeId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['day', 'updatedAt'])
                   && (request.resource.data.day == null
                       || (request.resource.data.day is int
                           && request.resource.data.day >= 1
                           && request.resource.data.day <= 5));
    }

    // Notes libres partagées :
    // { text: <string, 280 max>, by: <string, 40 max>, updatedAt: ... }.
    match /notes/{placeId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['text', 'by', 'updatedAt'])
                   && request.resource.data.text is string
                   && request.resource.data.text.size() <= 280
                   && request.resource.data.by is string
                   && request.resource.data.by.size() <= 40;
    }

    // Photo par lieu, stockée en data URL JPEG redimensionnée côté client :
    // { dataUrl: <string, 400 000 max>, by: <string, 40 max>, updatedAt: ... }.
    // Une chaîne vide = pas de photo.
    match /photos/{placeId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['dataUrl', 'by', 'updatedAt'])
                   && request.resource.data.dataUrl is string
                   && request.resource.data.dataUrl.size() <= 400000
                   && request.resource.data.by is string
                   && request.resource.data.by.size() <= 40;
    }

    // Tout le reste de la base est fermé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
